#!/usr/bin/env python3
"""Mirror a guest message into Android's logcat so a device report shows it.

The guest runs as the Android app's UID, so the logger socket accepts the
legacy logger_write frame: one priority byte, the tag, NUL, then the message.
The guest log files live inside the app's data directory and cannot be pulled
over adb, which makes logcat the only channel a crash report can carry them.

Failures are silent on purpose: diagnostics must never break the session.
"""
import socket
import sys

SOCKET = "/dev/socket/logdw"
PRIORITY = {"debug": 3, "info": 4, "warn": 5, "error": 6}


def main() -> int:
    if len(sys.argv) < 3:
        print("usage: arlinux-logcat LEVEL TAG MESSAGE...", file=sys.stderr)
        return 2
    level = PRIORITY.get(sys.argv[1], 4)
    tag = sys.argv[2]
    message = " ".join(sys.argv[3:]).encode("utf-8", "replace")
    if not message:
        return 0
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.connect(SOCKET)
            client.send(bytes([level]) + tag.encode("utf-8", "replace") + b"\0" + message)
    except OSError:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
