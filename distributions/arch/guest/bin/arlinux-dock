#!/bin/sh
# Start nwg-dock-hyprland, the alternative touch dock.
#
# Noctalia ships its own dock, enabled in 00-arlinux.toml. This helper exists
# for the comparison: it draws a dock from hyprctl IPC instead of the shell,
# so it also works when the shell cannot list windows. Run it with the
# Noctalia dock disabled ([dock] enabled = false).
set -u

exec nwg-dock-hyprland \
    -p bottom -a start -i 56 -w 10 -mb 10 -ml 24 -mr 24 \
    -c "nwg-drawer -d -c 6 -s 56 -r" \
    "$@"
