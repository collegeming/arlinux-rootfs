#!/bin/sh
# Start nwg-dock-hyprland, the dock that builds its window list from the host
# compositor's IPC instead of the shell's window integration. The image starts
# it next to the Noctalia dock so both can be compared on the device.
#
# The launcher button keeps the default command (`nwg-drawer`); the resident
# app grid that desktop.sh starts is toggled by that second invocation.
# Options: bottom edge, 56 px icons, no exclusive zone (the Noctalia dock
# already reserves space), margins that keep the rounded screen corners clear.
exec nwg-dock-hyprland \
    -p bottom -a start -i 56 -w 10 -mb 10 -ml 24 -mr 24 \
    "$@"
