#!/bin/sh
# Window operations for the touch desktop.
#
# The compositor belongs to the Android host, so nothing here reads or writes a
# Hyprland configuration file: every operation goes through the host's IPC
# socket. The hosted compositor runs the Lua dispatcher dialect while a stock
# Hyprland answers the classic one, so each operation tries Lua first and falls
# back to the classic dispatcher. hyprctl exits 0 even when it rejects a
# dispatcher, so success is decided by the reply, not by the exit status.
set -u

log="${XDG_RUNTIME_DIR:-/tmp}/arlinux-window.log"

active_address() {
    hyprctl -j activewindow 2>/dev/null \
        | tr ',' '\n' \
        | sed -n 's/.*"address"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n 1
}

dispatch() { # dispatcher [args...]
    reply="$(hyprctl dispatch "$@" 2>&1)"
    case "$reply" in
        *ok*) return 0 ;;
        *) last_reply="$reply"; return 1 ;;
    esac
}

close_window() {
    last_reply=""
    address="$(active_address)"
    if [ -n "$address" ]; then
        dispatch "hl.dsp.window.close({window=\"address:$address\"})" && return 0
        dispatch closewindow "address:$address" && return 0
    fi
    dispatch "hl.dsp.window.close()" && return 0
    # The classic dispatcher rejects a missing argument, and ignores the value
    # of dispatchers that take none.
    dispatch killactive 1 && return 0
    return 1
}

case "${1:-}" in
close)
    if ! close_window; then
        printf '%s close failed: %s\n' "$(date -Is)" "${last_reply:-no reply}" >> "$log" 2>/dev/null || true
        exit 1
    fi
    ;;
*)
    echo "usage: arlinux-window close" >&2
    exit 2
    ;;
esac
