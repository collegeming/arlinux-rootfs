# Kitty configuration for the ARLinux Arch desktop.
# Theme: Catppuccin Frappe (pinned copy at /usr/share/kitty/themes/frappe.conf).
# Font: Maple Mono NF CN (archlinuxcn package ttf-maplemono-nf-cn).
# Rendered from kitty.conf.in by distributions/arch/guest/install-desktop.sh,
# which substitutes the fontconfig family name for @MAPLE_FAMILY@.

include /usr/share/kitty/themes/frappe.conf

# Shell: fish stays the login shell here so the terminal matches the profile.
shell /usr/bin/fish --login --interactive

# Font
font_family @MAPLE_FAMILY@
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 14.0

# Window
window_padding_width 5
hide_window_decorations yes
remember_window_size no

# Translucency: the compositor-side blur rule in guest/desktop.sh makes the
# transparency readable. kitty's own background_blur has no effect under
# Wayland, so it is deliberately not set here.
background_opacity 0.85

# Cursor
cursor_shape block
cursor_color #ffffff
cursor_blink_interval 0.5
cursor_stop_blinking_after 0

# Neovide-style cursor trail (kitty >= 0.26)
cursor_trail 3
cursor_trail_decay 0.1 0.4
cursor_trail_start_threshold 2

# Misc
url_color #0087bd
confirm_os_window_close 0
scrollback_lines 10000
